<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!-- An enemy marker on the world map: a coloured dot with a dark edge, and a count when it stands for
	     several enemies seen in the same spot. Behaviour is in MapPins.lua. -->
	<Frame name="WantedDeadOrDeadEnemyPinTemplate" mixin="WantedDeadOrDeadEnemyPinMixin" enableMouseMotion="true" virtual="true">
		<Size x="12" y="12"/>
		<Layers>
			<Layer level="BORDER">
				<Texture parentKey="Border" setAllPoints="true">
					<Color r="0" g="0" b="0" a="1"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Dot">
					<Anchors>
						<Anchor point="TOPLEFT" x="2" y="-2"/>
						<Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<!-- How many enemies a merged marker holds -->
				<FontString parentKey="Count" inherits="GameFontHighlightSmall">
					<Anchors>
						<Anchor point="CENTER" x="0" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
</Ui>
